{
  "name": "sautocomplete-suggestion",
  "version": "1.2.0",
  "description": "A lightweight, dependency-free grouped autocomplete suggestion input (Vanilla TS). Sync + async dataSource, virtualized, sanitized, form-ready. Framework-agnostic with React, Vue and Angular wrappers.",
  "main": "dist/sautocomplete-suggestion.umd.js",
  "module": "dist/sautocomplete-suggestion.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "frameworks",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/sautocomplete-suggestion.esm.js",
      "require": "./dist/sautocomplete-suggestion.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/styles.css": "./dist/styles.css",
    "./frameworks/*": "./frameworks/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:unit": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:chromium": "npx playwright test --project=chromium",
    "bench": "npx vitest bench",
    "lint": "eslint src/ frameworks/react.tsx",
    "size": "node scripts/check-size.mjs",
    "demo": "open demo/index.html",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "autocomplete",
    "suggestion",
    "grouped-suggestions",
    "search-input",
    "vanilla-js",
    "lightweight",
    "dependency-free",
    "react",
    "vue",
    "angular"
  ],
  "author": "",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "rollup": "^4.9.0",
    "rollup-plugin-css-only": "^4.5.2",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10"
  }
}
